{
  "info": {
    "name": "TaskFlow API",
    "description": "API collection for TaskFlow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Board",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/boards/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "boards",
            "1"
          ]
        },
        "description": "Fetch the main board with its columns and tasks."
      },
      "response": []
    },
    {
      "name": "Get Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/tasks?priority=High",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "tasks"
          ],
          "query": [
            {
              "key": "priority",
              "value": "High"
            }
          ]
        },
        "description": "Fetch all tasks, optionally filtered by priority."
      },
      "response": []
    },
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New Task\",\n  \"description\": \"Task description\",\n  \"columnId\": 1,\n  \"priority\": \"Medium\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/tasks",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "tasks"
          ]
        },
        "description": "Create a new task."
      },
      "response": []
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Task Title\",\n  \"description\": \"Updated description\",\n  \"priority\": \"High\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/tasks/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "tasks",
            "1"
          ]
        },
        "description": "Update an existing task."
      },
      "response": []
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/tasks/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "tasks",
            "1"
          ]
        },
        "description": "Delete a task."
      },
      "response": []
    },
    {
      "name": "Move Task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"columnId\": 2\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/tasks/1/column",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "tasks",
            "1",
            "column"
          ]
        },
        "description": "Move a task to a different column."
      },
      "response": []
    }
  ]
}
